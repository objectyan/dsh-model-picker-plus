{
  "name": "dsh-model-picker-plus",
  "version": "0.3.1",
  "description": "A grouped, searchable replacement for the DSH composer model selector.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/objectyan/dsh-model-picker-plus.git"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --check client.js && node tests/client.mjs",
    "update:metadata": "node scripts/update-model-metadata.mjs",
    "update:brand-icons": "node scripts/update-brand-icons.mjs && node scripts/preview-brand-icons.mjs",
    "update:brand-logos": "node scripts/update-brand-logos.mjs && node scripts/render-brand-logos.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "model-selector",
    "dsh-bundle"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "potrace": "^2.1.8",
    "sharp": "^0.35.4"
  }
}
